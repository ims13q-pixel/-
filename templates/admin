<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Admin Panel</title>
<style>
    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap');
    body { margin: 0; background: #0b0e14; color: #fff; font-family: 'Inter', sans-serif; padding: 20px; }
    .container { max-width: 800px; margin: 0 auto; }
    .card { background: #11151f; padding: 20px; border-radius: 12px; border: 1px solid #1e2433; }
    h2 { margin-top: 0; }
    ul { list-style: none; padding: 0; }
    li { background: #0b0e14; padding: 12px; margin-bottom: 8px; border-radius: 8px; border: 1px solid #1e2433; display: flex; justify-content: space-between; }
    .btn { background: #3b82f6; color: white; text-decoration: none; padding: 10px 20px; border-radius: 8px; display: inline-block; margin-bottom: 20px;}
</style>
</head>
<body>
<div class="container">
    <a href="/" class="btn">← Back to Dashboard</a>
    <div class="card">
        <h2>Registered Users (Admin Only)</h2>
        <ul>
            {% for user in users %}
                <li>
                    <span style="font-weight:bold;">{{ user }}</span>
                    <span style="color: #8b93a3; font-size: 13px;">Key / Username</span>
                </li>
            {% endfor %}
        </ul>
    </div>
</div>
</body>
</html>
